# 2. Store & App Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Admin Authentication & Security (sign in at /admin/login)
ADMIN_JWT_SECRET="teabox_super_secure_jwt_admin_secret_key_2026_x89a_99182746"
ADMIN_DEFAULT_EMAIL="admin@teabox.com"
ADMIN_DEFAULT_PASSWORD="admin123456"

# 4. TeaPay: Native UPI Gateway
UPI_ID="8617513004@ptaxis"
UPI_PAYEE_NAME="Teabox India"

# 5. WhatsApp Service (QR login, OTP verification & order alerts)
