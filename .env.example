# ====================================================
# Teabox Production (Vercel) & Local Configuration
# ====================================================

# 1. PostgreSQL Database (Prisma ORM)
# On Vercel: Use Neon, Supabase, Vercel Postgres, or AWS RDS
# If using a serverless pooled connection (e.g. Neon/Supabase), use the pooled URL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teabox?schema=public"

# 2. Store & App Domain
NEXT_PUBLIC_APP_URL="https://your-teabox.vercel.app"

# 3. Admin Authentication & Security
# Generate a strong 32+ character random string for production
# REQUIRED in production. Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET="replace-with-a-long-random-string"
ADMIN_DEFAULT_EMAIL="admin@teabox.com"
# REQUIRED in production (it creates your first admin on first login)
ADMIN_DEFAULT_PASSWORD="replace-with-a-strong-password"

# 4. YouPI-PG UPI Payment Gateway
# Payment core (apps/payment-api). When set, checkout uses WhatsApp OTP + automatic
# bank confirmation. Leave empty for manual UPI (customer types UTR, admin confirms).
# On Vercel this must be a public https URL of your YouPI server, not localhost.
YOUPI_PG_BASE_URL="http://localhost:6100"
# Merchant hub (apps/merchant-admin), used for links on the admin Payment Gateway page
YOUPI_ADMIN_URL="http://localhost:6001"
# Optional: YouPI ADMIN_API_TOKEN (YouPI keeps it in data/.secrets/admin_api_token).
# Only used read-only, to show WhatsApp connection status in the shop admin.
YOUPI_ADMIN_TOKEN=""
# Optional: only needed if your YouPI has more than one merchant
YOUPI_MERCHANT_ID=""
# REQUIRED in production: the UPI ID that receives payments
YOUPI_MERCHANT_VPA="8617513004@ptaxis"
YOUPI_MERCHANT_NAME="Teabox India"
# REQUIRED: must match YouPI Store Settings → Webhook Secret. Webhooks are rejected
# when this is empty. The shop also sends it to YouPI as the merchant API key.
YOUPI_WEBHOOK_SECRET=""

# 5. Order Notification Email & Outbound Mail Service
ADMIN_ORDER_NOTIFICATION_EMAIL="dipakh810@gmail.com"

# Optional: Gmail / SMTP for live email dispatch (Nodemailer)
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-app-password"

# Optional: Resend API Key (https://resend.com)
RESEND_API_KEY=""
