# ====================================================
# Teabox Production (Vercel) & Local Configuration
# ====================================================

# 1. PostgreSQL Database (Prisma ORM). REQUIRED for the UPI gateway (TeaPay).
# On Vercel: use Neon, Supabase or Vercel Postgres (pooled URL), then run: npm run db:push && npm run db:seed
# Local without installing Postgres: `npm run dev` starts a local database when you use:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 2. Store & App Domain
NEXT_PUBLIC_APP_URL="https://your-teabox.vercel.app"

# 3. Admin Authentication & Security (sign in at /admin/login)
# REQUIRED in production. Signs admin sessions and protects gateway secrets.
# Generate with: openssl rand -base64 48   (changing it later signs everyone out and
# requires reconnecting Gmail)
ADMIN_JWT_SECRET="replace-with-a-long-random-string"
# The main admin. This password is the only one that works for this email: to change the
# password, change it here (or on Vercel) and redeploy. Use 12+ random characters.
ADMIN_DEFAULT_EMAIL="admin@teabox.com"
ADMIN_DEFAULT_PASSWORD="replace-with-a-strong-password"

# 4. TeaPay: the shop's own UPI gateway
# Money goes straight to this UPI ID. Each checkout gets a unique amount (up to ₹0.99 less
# than the order total), and the order confirms when your bank's SMS or email reports it.
UPI_ID="8617513004@ptaxis"
UPI_PAYEE_NAME="Teabox India"

# WhatsApp code at checkout. Leave all empty to skip verification.
# Option 1 (QR login, like WhatsApp Web): run whatsapp-service/ on an always-on host
# (your computer, Railway, a VPS; NOT Vercel), then scan its QR in Admin → Payment Gateway.
# e.g. https://teabox-whatsapp.up.railway.app
WHATSAPP_SERVICE_URL=""
# the same long random value as WHATSAPP_SERVICE_TOKEN on the service
WHATSAPP_SERVICE_TOKEN=""
# Option 2 (official WhatsApp Cloud API, Meta): approved "Authentication" template with copy-code button
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_API_VERSION="v22.0"

# Gmail bank alerts (Google Cloud OAuth client, Gmail API enabled, read-only scope).
# Authorized redirect URI: https://<your-domain>/api/admin/gateway/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: extra bank email domains, comma separated (common Indian banks are built in)
# GMAIL_ALERT_DOMAINS="mybank.co.in"

# Vercel Cron secret for /api/pay/cron (daily clean-up + Gmail check)
CRON_SECRET="replace-with-a-long-random-string"

# 5. Order Notification Email & Outbound Mail Service
ADMIN_ORDER_NOTIFICATION_EMAIL="dipakh810@gmail.com"

# Needed in production for customer sign-in codes and order emails: set Gmail OR Resend.
# Gmail / SMTP for live email dispatch (Nodemailer)
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-app-password"

# Resend API Key (https://resend.com)
RESEND_API_KEY=""
