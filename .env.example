# ====================================================
# Teabox Production (Vercel) & Local Configuration
# ====================================================

# 1. PostgreSQL Database (Prisma ORM)
# On Vercel: Use Neon, Supabase, Vercel Postgres, or AWS RDS
# If using a serverless pooled connection (e.g. Neon/Supabase), use the pooled URL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teabox?schema=public"

# 2. Store & App Domain
NEXT_PUBLIC_APP_URL="https://your-teabox.vercel.app"

# 3. Admin Authentication & Security
# Generate a strong 32+ character random string for production
ADMIN_JWT_SECRET="teabox_super_secure_admin_jwt_secret_key_2026_xyz987_prod"
ADMIN_DEFAULT_EMAIL="admin@teabox.com"
ADMIN_DEFAULT_PASSWORD="adminTeabox2026!"

# 4. YouPI-PG UPI Payment Gateway
YOUPI_MERCHANT_VPA="8617513004@ptaxis"
YOUPI_MERCHANT_NAME="Teabox India"
YOUPI_PG_BASE_URL=""
YOUPI_PUBLIC_KEY="youpi_pk_live_teabox"
YOUPI_WEBHOOK_SECRET="youpi_whsec_teabox_secret_2026"

# 5. Order Notification Email & Outbound Mail Service
