# =========================================================================
# Teabox Full Example Environment File (.env.example)
# Use this reference template to configure your local or production environment.
# =========================================================================

# -------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Prisma ORM)
# -------------------------------------------------------------------------
# For Local Development (automatic embedded database with `npm run dev`):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"

# For Production (Neon, Supabase, or AWS RDS):
# DATABASE_URL: Pooled connection string (used by Next.js app queries)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DATABASE_URL_UNPOOLED: Direct connection string (used for schema migrations & Prisma CLI)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# -------------------------------------------------------------------------
# 2. STORE APP DOMAIN
# -------------------------------------------------------------------------
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production:
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# -------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION & SECURITY (Sign in at /admin/login)
# -------------------------------------------------------------------------
# Generate a secure JWT secret: openssl rand -base64 48
ADMIN_JWT_SECRET="replace-with-a-random-secret-key-at-least-32-chars-long"
ADMIN_DEFAULT_EMAIL="admin@teabox.com"
ADMIN_DEFAULT_PASSWORD="replace-with-a-strong-password"

# -------------------------------------------------------------------------
# 4. TEAPAY: NATIVE UPI PAYMENT GATEWAY
# -------------------------------------------------------------------------
# Payments go directly to this UPI ID without intermediary aggregator fees.
UPI_ID="8617513004@ptaxis"
UPI_PAYEE_NAME="Teabox India"

# -------------------------------------------------------------------------
# 5. ORDER NOTIFICATIONS & EMAIL DELIVERY
# -------------------------------------------------------------------------
ADMIN_ORDER_NOTIFICATION_EMAIL="admin@yourdomain.com"

# Gmail App Password delivery (SMTP via Nodemailer)
# Generate a 16-character password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional: Resend API Key alternative (https://resend.com)
RESEND_API_KEY=""

# -------------------------------------------------------------------------
# 6. SCHEDULED CRON MAINTENANCE
# -------------------------------------------------------------------------
# Used to secure endpoints like /api/pay/cron
CRON_SECRET="replace-with-a-random-cron-secret-key"

# -------------------------------------------------------------------------
# 7. WHATSAPP GATEWAY SERVICE (Optional)
# -------------------------------------------------------------------------
# Option A: Self-hosted WhatsApp Web QR service (running in whatsapp-service/)
WHATSAPP_SERVICE_URL="http://127.0.0.1:7071"
WHATSAPP_SERVICE_TOKEN="replace-with-service-token"

# Option B: Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_API_VERSION="v22.0"

# -------------------------------------------------------------------------
# 8. GOOGLE OAUTH FOR GMAIL ALERTS (Optional)
# -------------------------------------------------------------------------
# Authorized redirect URI: https://<your-domain>/api/admin/gateway/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
