    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
